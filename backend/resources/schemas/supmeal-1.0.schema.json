{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://4meal.example/schemas/supmeal-1.0.schema.json",
  "title": "SUPMEAL export format",
  "description": "Versioned, platform-neutral recipe and cookbook export.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "exported_at", "cookbooks", "recipes"],
  "properties": {
    "format": { "const": "SUPMEAL" },
    "version": { "const": "1.0.0" },
    "exported_at": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/definitions/source" },
    "cookbooks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/cookbook" } },
    "recipes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/recipe" } },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "definitions": {
    "source": { "type": "object", "additionalProperties": false, "required": ["application"], "properties": { "application": { "type": "string", "minLength": 1, "maxLength": 100 }, "application_version": { "type": "string", "minLength": 1, "maxLength": 50 } } },
    "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "nonNegativeInt": { "type": "integer", "minimum": 0 },
    "nonNegativeNumber": { "type": "number", "minimum": 0 },
    "cookbook": { "type": "object", "additionalProperties": false, "required": ["id", "name", "recipe_ids"], "properties": {
      "id": { "type": "string", "pattern": "^supmeal:cookbook:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" },
      "name": { "$ref": "#/definitions/text" }, "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 200 },
      "description": { "type": ["string", "null"], "maxLength": 10000 },
      "recipe_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^supmeal:recipe:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" } },
      "image_url": { "type": "string", "format": "uri", "maxLength": 2048 }
    } },
    "ingredient": { "type": "object", "additionalProperties": false, "required": ["name", "quantity", "unit", "preparation", "optional", "group"], "properties": {
      "name": { "$ref": "#/definitions/text" }, "quantity": { "anyOf": [{ "$ref": "#/definitions/nonNegativeNumber" }, { "type": "null" }] },
      "unit": { "type": ["string", "null"], "maxLength": 100 }, "preparation": { "type": ["string", "null"], "maxLength": 1000 },
      "optional": { "type": "boolean" }, "group": { "type": ["string", "null"], "maxLength": 200 }
    } },
    "step": { "type": "object", "additionalProperties": false, "required": ["position", "instruction", "duration_minutes", "image_url"], "properties": {
      "position": { "type": "integer", "minimum": 1 }, "instruction": { "$ref": "#/definitions/text" },
      "duration_minutes": { "anyOf": [{ "$ref": "#/definitions/nonNegativeInt" }, { "type": "null" }] }, "image_url": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 }
    } },
    "recipe": { "type": "object", "additionalProperties": false, "required": ["id", "title", "description", "servings", "prep_time_minutes", "cook_time_minutes", "rest_time_minutes", "ingredients", "steps", "tags", "cookbook_ids"], "properties": {
      "id": { "type": "string", "pattern": "^supmeal:recipe:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" }, "title": { "$ref": "#/definitions/text" },
      "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 200 }, "description": { "type": ["string", "null"], "maxLength": 10000 },
      "servings": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }, "prep_time_minutes": { "anyOf": [{ "$ref": "#/definitions/nonNegativeInt" }, { "type": "null" }] },
      "cook_time_minutes": { "anyOf": [{ "$ref": "#/definitions/nonNegativeInt" }, { "type": "null" }] }, "rest_time_minutes": { "anyOf": [{ "$ref": "#/definitions/nonNegativeInt" }, { "type": "null" }] },
      "ingredients": { "type": "array", "items": { "$ref": "#/definitions/ingredient" } }, "steps": { "type": "array", "items": { "$ref": "#/definitions/step" } },
      "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/text" } }, "cookbook_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^supmeal:cookbook:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" } },
      "notes": { "type": ["string", "null"], "maxLength": 10000 }, "source": { "type": ["string", "null"], "maxLength": 2048 }, "image_url": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 }
    } }
  }
}
