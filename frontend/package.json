{
  "name": "4meal-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "lint": "eslint src vite.config.ts --max-warnings=0",
    "openapi:validate": "redocly lint --config ../docs/openapi/redocly.yaml ../docs/openapi/openapi.yaml",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.11.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.7"
  }
}
